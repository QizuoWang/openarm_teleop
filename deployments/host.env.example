# Copy to <repository>/.openarm-deploy.env and uncomment only overrides needed.
# Trusted shell configuration: use absolute paths; do not commit secrets here.
# Defaults assume sibling lerobot/, hikrobot/, and .venv/ directories.

# OPENARM_WORKSPACE=/home/operator/openarm
# OPENARM_LEROBOT_ROOT=/home/operator/openarm/lerobot
# OPENARM_POLICY_PYTHON=/home/operator/openarm/.venv/bin/python
# OPENARM_DEPLOY_PYTHON=/home/operator/openarm/dora-openarm-data-collection/.venv-deploy/bin/python
# HIKROBOT_MV3D_LIB=/opt/hikrobot/lib
# OPENARM_ROBOT_CONFIG=/home/operator/openarm/dora-openarm-data-collection/openarm_pedestal_vr.yaml

# Physical camera assignment; never infer these from USB enumeration order.
# OPENARM_CAMERA_RIGHT_SERIAL=00DA8573792
# OPENARM_CAMERA_LEFT_SERIAL=00DB1265540
# OPENARM_CAMERA_BASE_SERIAL=00DA8573794

# Only needed when departing from the documented SmolVLA checkpoint layout.
# Update the manifest checkpoint path to match; do not bypass artifact hashes.
# OPENARM_SMOLVLA_CHECKPOINT=/absolute/path/to/pretrained_model
# OPENARM_SMOLVLA_MANIFEST=/absolute/path/to/deployment.local.json
